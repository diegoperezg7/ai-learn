# Puerto expuesto del frontend (LAN / Tailscale). El portal no lo necesita.
WEB_PORT=5183

# Ponlo a true cuando la app esté detrás del auth-proxy de darc3.
# Con true, la API exige las cabeceras X-Auth-* que inyecta AIdentity.
REQUIRE_PORTAL_AUTH=false

# Calendario del roadmap
SPRINT_START=2026-08-21
CORE_DEADLINE=2026-11-29
FINAL_DEADLINE=2026-12-31
WEEKLY_TARGET_HOURS=6

# Coach IA local (Ollama en el Mac Mini)
COACH_ENABLED=true
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b

# Portal (docker-compose.portal.yml). Obligatorio solo contra supabase-db.
# Sustituye el valor por la contraseña ya rotada. .env no se versiona.
POSTGRES_PASSWORD=replace-with-rotated-password
