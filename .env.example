# Frontend port on the local network. The public portal does not need it.
WEB_PORT=5183

# Set to true when the app sits behind the SSO forward-auth proxy
# (self-hosted home server: Cloudflare Tunnel + Caddy + SSO).
# When true, the API requires the X-Auth-* headers injected by the proxy.
REQUIRE_PORTAL_AUTH=false

# Roadmap calendar
SPRINT_START=2026-08-21
CORE_DEADLINE=2026-11-29
FINAL_DEADLINE=2026-12-31
WEEKLY_TARGET_HOURS=6

# Local AI coach (Ollama on the host)
COACH_ENABLED=true
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b

# Portal (docker-compose.portal.yml). Required only for the portal Postgres service.
# Replace the placeholder with the rotated password. .env is not committed.
POSTGRES_PASSWORD=replace-with-rotated-password
